# API_TIMEOUT=30
# BASE_RATE_LIMIT_DELAY=3.0
# MAX_RETRIES=3

# Database Configuration
# DB_PATH=data/options_data.db
# DB_TIMEOUT=30.0
# DB_CACHE_SIZE=-64000

# Logging
# LOG_LEVEL=INFO
