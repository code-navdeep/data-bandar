# ===========================
# REQUIRED: Dhan API Credentials
# ===========================
# Get these from: https://web.dhan.co → Settings → API Management

DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here


# ===========================
# OPTIONAL: Advanced Settings
